{
  "expo": {
    "name": "CampusSentinel - School Management",
    "slug": "campussentinel",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "description": "A comprehensive school management system for students, parents, and administrators. Manage attendance, fees, homework, events, and more.",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.campussentinel.app"
    },
    "android": {
      "package": "com.campussentinel.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "build": {
        "babel": {
          "include": [
            "@expo/vector-icons"
          ]
        }
      },
      "performance": {
        "lazyLoading": true,
        "bundleSplitting": true
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to photos to allow users to upload profile pictures and documents.",
          "cameraPermission": "The app needs access to camera to take pictures for profiles and documents."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2196F3",
          "defaultChannel": "default",
          "sounds": [
            "./sounds/campus_sentinel_message.mp3",
            "./sounds/campus_sentinel_notification.mp3"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3ae3272b-d679-4976-aa73-b79d98315b85"
      }
    },
    "owner": "nikhil850723"
  }
}
